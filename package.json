{
  "name": "ivy-pizza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "start:host": "node app.cjs",
    "test": "tsx --test tests/*.test.ts",
    "local": "node scripts/local-stack.mjs",
    "local:reset": "node scripts/local-stack.mjs --reset",
    "local:down": "node scripts/local-stack.mjs down"
  },
  "dependencies": {
    "better-auth": "^1.7.10",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
