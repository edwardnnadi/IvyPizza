{
  "name": "ivy-pizza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "start:host": "tsx server/host.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "selfsigned": "2.4.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
