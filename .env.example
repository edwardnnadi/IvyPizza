# Supabase Postgres connection string (server only).
DATABASE_URL=
DATABASE_CA_CERT=./prod-ca-2021.crt

# Supabase URL and publishable key (only needed when using Supabase Auth in the browser).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local development defaults. Production values belong in the hosting provider.
API_PORT=3001
BUSINESS_TIMEZONE=Africa/Lagos
