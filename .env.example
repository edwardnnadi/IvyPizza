# Supabase PostgreSQL connection (API only).
DATABASE_URL=
DATABASE_CA_CERT=./prod-ca-2021.crt

# Better Auth API origin and signing secret (server only).
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://theivypizza.com,https://www.theivypizza.com
AUTH_FRONTEND_URL=https://theivypizza.com
# Set after api.theivypizza.com is configured, for example: .theivypizza.com
AUTH_COOKIE_DOMAIN=

# Choose smtp or resend. Resend sends over HTTPS and works on Render Free.
EMAIL_PROVIDER=smtp

# WhoGoHost mailbox SMTP credentials (server only; used with EMAIL_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=The Ivy Pizza <orders@theivypizza.com>

# Resend API key (server only; used with EMAIL_PROVIDER=resend).
RESEND_API_KEY=

# Browser API origin. Leave blank when using the local Vite proxy.
VITE_API_BASE_URL=

# Exact browser origins permitted to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://theivypizza.com,https://www.theivypizza.com

API_PORT=3001
BUSINESS_TIMEZONE=Africa/Lagos
CHECKOUT_DELIVERY_FEE_MINOR=150000
CHECKOUT_TAX_BASIS_POINTS=0
