# MariaDB connection (API only). Local development can use the Docker database described in README.md.
# On WhoGoHost: mysql://theivypi_zza:PASSWORD@localhost/theivypi_zza (URL-encode special characters in the password).
DATABASE_URL=
# On WhoGoHost, connect over the local socket: /var/lib/mysql/mysql.sock
DATABASE_SOCKET_PATH=
# Only for a remote database that requires TLS.
DATABASE_CA_CERT=

# Better Auth API origin and signing secret (server only).
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://theivypizza.com,https://www.theivypizza.com
AUTH_FRONTEND_URL=https://theivypizza.com
# Set after api.theivypizza.com is configured, for example: .theivypizza.com
AUTH_COOKIE_DOMAIN=

# Choose smtp or resend. On WhoGoHost, use smtp with the theivypizza.com mail server.
EMAIL_PROVIDER=smtp

# WhoGoHost mail server (server only; used with EMAIL_PROVIDER=smtp).
SMTP_HOST=mail.theivypizza.com
SMTP_PORT=465
SMTP_SECURE=true

# Each kind of email is sent from its own mailbox, logged in with that mailbox's own password.
# _FROM is optional and defaults to "The Ivy Pizza <mailbox address>".
# Customers: account confirmation and password reset for customers. Required.
SMTP_CUSTOMERS_USER=customers@theivypizza.com
SMTP_CUSTOMERS_PASSWORD=
SMTP_CUSTOMERS_FROM=
# Staff: account emails for anyone with a staff role. Required.
SMTP_STAFF_USER=staff@theivypizza.com
SMTP_STAFF_PASSWORD=
SMTP_STAFF_FROM=
# Orders: order emails (not sent yet).
SMTP_ORDERS_USER=orders@theivypizza.com
SMTP_ORDERS_PASSWORD=
SMTP_ORDERS_FROM=
# Solutions: help with problems (not sent yet).
SMTP_SOLUTIONS_USER=solutions@theivypizza.com
SMTP_SOLUTIONS_PASSWORD=
SMTP_SOLUTIONS_FROM=

# Resend API key (server only; used with EMAIL_PROVIDER=resend).
RESEND_API_KEY=

# Browser API origin. Leave blank when using the local Vite proxy.
VITE_API_BASE_URL=

# Exact browser origins permitted to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://theivypizza.com,https://www.theivypizza.com

API_PORT=3001
BUSINESS_TIMEZONE=Africa/Lagos
# Delivery fees and minimums are per area (delivery_zones table). Tax applies to the subtotal after discounts.
CHECKOUT_TAX_BASIS_POINTS=0

# Guest checkout (orders without an account). Set to false to require sign-in.
GUEST_CHECKOUT=true
# Bank transfer is offered only when all three are set. Unpaid transfers are cancelled after 30 minutes.
TRANSFER_BANK_NAME=
TRANSFER_ACCOUNT_NUMBER=
TRANSFER_ACCOUNT_NAME=
# Shown on the order tracker so customers can call about an order. Hidden when blank.
KITCHEN_PHONE=
